# React frontend. Render Blueprint fills the API URL from the backend service.
VITE_AI_API_URL=http://localhost:7860

# Public frontend origin used for canonical and social metadata. Do not add a trailing slash.
VITE_SITE_URL=http://localhost:5173

# Optional Google Analytics 4 Measurement ID. Analytics remains disabled until
# a visitor explicitly allows it in the cookie banner.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
