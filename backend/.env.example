# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
TRUST_PROXY_HEADERS=false
PUBLIC_RESUME_URL=/resumes/OmkarMahabdi_AIML.pdf
PORTFOLIO_URL=http://localhost:5173

# Retrieval. Render uses the lightweight lexical path by default.
# Install requirements-semantic-rag.txt before enabling the optional semantic path.
ENABLE_SEMANTIC_RAG=false
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_LOCAL_FILES_ONLY=true
RAG_TOP_K=5
RAG_MIN_SCORE=0.08

# Dedicated Hugging Face Gradio ZeroGPU model Space.
# Example: your-hf-username/omkar-qwen3-4b
HF_GRADIO_SPACE_ID=
HF_GRADIO_API_NAME=/generate
# Recommended for authenticated ZeroGPU quota; keep this backend-only.
HF_TOKEN=
HF_GRADIO_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=384
LLM_TEMPERATURE=0.2

# SMTP. Keep real values in platform secrets or an uncommitted .env file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Omkar Mahabdi
CONTACT_RECIPIENT_EMAIL=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Process-local rate limits. Use a shared gateway/store when scaling past one worker.
CHAT_RATE_LIMIT=30
JD_RATE_LIMIT=10
EMAIL_RATE_LIMIT=3
CONTACT_RATE_LIMIT=5
STANDARD_RATE_WINDOW_SECONDS=60
SENSITIVE_RATE_WINDOW_SECONDS=3600
